<?php 
    // LOGIN.PHP HANDLES USER VERIFICATION
    require_once 'db.php';
    //LOADS THE WHOLE DATABSE TO THIS PHP FILE

    // THIS DESCRIBES WHAT IS IT FOR 
    header('Content-Type: application/json');
    // CAPTURING LOGIN CREDENTIALS
    if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
        http_response_code(405);
        echo json_encode(['status' => 'error', 'message' => 'Method not allowed.']);
        exit;
    }

    //FILTERS OUT THE SPACES IN THE USER INPUT
    $email = trim($_POST['email'] ?? '');
    $password = $_POST['password'] ?? '';
    //IF THE EMAIL AND PASSWORD FIELDS ARE EMPTY
    if ($email === '' || $password === '') {
        //THEN: ECHO OR PRINT OUT THE  ERROR MESSAGE
        echo json_encode(['status' => 'error', 'message' => 'please fill out your email and password before loging in.']);
        exit;
    }

    // SEARCHING THE DATABASE SECURELY AFTER ACCEPTING THE CREDENTIALS
    //USE THE CREDENTIALS TO SEARCH OUT THE USERS INFO STORED IN THE TABLE
    $query = "SELECT id, fullname, password
              FROM users
              WHERE email = $1";
    // TELLS pg_query_params TO SEARCH IN THE dbconn AND RUNS A CHECK WITH THE QUERY
    $result = pg_query_params($dbconn, $query, array($email));

    if ($result === false) {
        http_response_code(500);
        echo json_encode(['status' => 'error', 'message' => 'Unable to process login right now.']);
        exit;
    }

    //VERIFYING THE CREDENTIALS AFTER FETCHING IT
    $row = pg_fetch_assoc($result);
    if ($row && password_verify($password, $row['password'])) {
        echo json_encode(['status' => 'success', 'message' => 'welcome back ' . $row['fullname'] . '!',
        'user' => [
            'fullname' => $row['fullname'],
            'email' => $row['email'],
        ]
        ]);
        exit;
    }

    echo json_encode(['status' => 'error', 'message' => 'Invalid email or password.']);

?>
document.addEventListener('DOMContentLoaded', () => {
    // SAVES REGISTER FORM
    const registerForm = document.getElementById('register-form');
    // SAVES LOGIN FORM
    const loginForm = document.getElementById('login-form');
    // THIS APPEARS IN HTML CODE LINE 32 <div id="alert-box" class="alert-hidden"></div>
    const alertBox = document.getElementById('alert-box');
    
    // ALERT HELPER FUNCTION
    function showAlert(message, type){
        alertBox.textContent = message;
        alertBox.className = `alert ${type}`;
    }

    // HANDLING NEW USER REGISTRATION
    registerForm.addEventListener('submit', async (e) => {
        e.preventDefault(); // Prevent full page reload
        const formData = new FormData(registerForm);
        try {
            const response = await fetch('register.php', { method: 'POST', body: formData });
            const result = await response.json();
            
            if (result.status === 'success') {
                showAlert(result.message, 'success');
                registerForm.reset();
            } else {
                showAlert(result.message, 'error');
            }
        } catch (err) {
            showAlert('An error occurred connecting to server. Refresh and try again.', 'error');
        }
    });

    // HANDLES EXISTING USER LOGIN
    loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(loginForm);

        try {
            const response = await fetch('login.php', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (result.status === 'success') {
                showAlert(result.message, 'success');
                loginForm.reset();

                //SAVE USER SESSION IN THE LOCAL BROWSER
                localStorage.setItem('pizza_user', JSON.stringify(result.user));
                checkUserSession(); // Call the function to update the UI based on the user session
            } else {
                showAlert(result.message, 'error');
            }
        } catch (err) {
            console.error("Fetch Error Details:", err); // <-- This will show the exact reason in your Console
            showAlert('An error occurred connecting to the server.', 'error');
        }
    });

    // --- INTERACTIVE SHOPPING CART LOGIC ---
    const cart = [];
    const cartItemsContainer = document.getElementById('cart-items');
    const cartTotalPrice = document.getElementById('cart-total-price');
    const checkoutBtn = document.getElementById('checkout-btn');

    // Select all "Add to Order" buttons on the menu cards
    const addToOrderButtons = document.querySelectorAll('.menu-card button');

    addToOrderButtons.forEach(button => {
        button.addEventListener('click', (e) => {
            const card = e.target.closest('.menu-card');
            const title = card.querySelector('h3').textContent;
            const priceText = card.querySelector('.price').textContent;
            // Extract numerical value from price (e.g., "₵45.00" -> 45.00)
            const price = parseFloat(priceText.replace('₵', ''));

            // Check if item already exists in the cart array
            const existingItem = cart.find(item => item.title === title);
            if (existingItem) {
                existingItem.quantity += 1;
            } else {
                cart.push({ title, price, quantity: 1 });
            }

            updateCartUI();
        });
    });

 function updateCartUI() {
        cartItemsContainer.innerHTML = '';

        if (cart.length === 0) {
            cartItemsContainer.innerHTML = '<p id="empty-cart-msg" style="text-align:center; color:#666; padding: 1rem;">Your cart is empty. Pick a delicious pizza above!</p>';
            cartTotalPrice.textContent = '₵0.00';
            checkoutBtn.disabled = true;
            return;
        }

        let total = 0;
        cart.forEach((item, index) => {
            const itemTotal = item.price * item.quantity;
            total += itemTotal;

            const cartItemEl = document.createElement('div');
            cartItemEl.className = 'cart-item';
            cartItemEl.innerHTML = `
                <span><strong>${item.title}</strong> (x${item.quantity})</span>
                <span>₵${itemTotal.toFixed(2)} <button class="remove-btn" data-index="${index}" title="Remove item">🗑️</button></span>
            `;
            cartItemsContainer.appendChild(cartItemEl);
        });

        cartTotalPrice.textContent = `₵${total.toFixed(2)}`;
        checkoutBtn.disabled = false;

        // Attach event listeners to individual remove buttons inside the cart
        document.querySelectorAll('.remove-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const index = parseInt(e.target.getAttribute('data-index'));
                cart.splice(index, 1);
                updateCartUI();
            });
        });
    }

    // Checkout button handler
// Checkout button handler - Sends order data to backend
    checkoutBtn.addEventListener('click', async () => {
        const totalVal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
        const userEmail = window.currentUserEmail || 'guest@manupizza.com';

        //CHECKOUT BUTTON REACT IMMEDIATELY
        checkoutBtn.textContent = 'Processing orde..';
        checkoutBtn.disabled = true;
        
        try {
            const response = await fetch('checkout.php', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    email: userEmail,
                    cart: cart,
                    total: totalVal
                })
            });

            const result = await response.json();
            if (result.status === 'success') {
                showAlert(result.message, 'success');

                // WHATASAP INTEGRATION: Open WhatsApp with pre-filled order details
                const summaryParts = cart.map(item => `${item.title} (x${item.quantity})`);
                const orderSummaryText = summaryParts.join(', ');
                const whatsappNumber = "233597787700";// WHATSAP LINE
                const whatsappMessage = `🍕 *NEW MANU PIZZA ORDER IN JUST NOW!!* 🍕\n\n*Customer:* ${userEmail}\n*Items:* ${orderSummaryText}\n*Total:* ₵${totalVal.toFixed(2)}`;

                // PREFILL ORDER DETAILS FOR WHATSAPP   
                const whatsappURL = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
                window.open(whatsappURL, '_blank');

                cart.length = 0; // Clear the cart array
                updateCartUI();
            } else {
                showAlert(result.message, 'error');
            }
        } catch (err) {
            showAlert('An error occurred connecting to the server for checkout.', 'error');
        } finally {
            checkoutBtn.textContent = 'Checkout NOW !!';
            checkoutBtn.disabled = false;
        }
    });

    // Check session on page load
    function checkUserSession() {
        const savedUser = localStorage.getItem('pizza_user');
        const authContainer = document.getElementById('auth-section');

        if (savedUser) {
            const user = JSON.parse(savedUser);
            // Replace authentication forms with a personalized welcome card
            authContainer.innerHTML = `
                <div class="form-card" style="text-align: center; max-width: 500px; margin: 0 auto;">
                    <h2>Welcome, ${user.fullname}! 🍕</h2>
                    <p style="color: #666; margin-bottom: 1.5rem;">Logged in as: <strong>${user.email}</strong></p>
                    <p style="margin-bottom: 1.5rem; color: #28a745; font-weight: bold;">You are ready to order and checkout!</p>
                    <button id="logout-btn" class="btn btn-secondary">Logout</button>
                </div>
            `;

            // Attach logout handler
            document.getElementById('logout-btn').addEventListener('click', () => {
                localStorage.removeItem('pizza_user');
                window.location.reload(); // Reset page back to login state
            });

            // Also update the checkout email dynamically with the logged-in user's email
            window.currentUserEmail = user.email;
        }
    }

    // Run session check when page loads
    checkUserSession();
});
<?php
// db.php - Connects PHP backend to PostgreSQL database

$host     = "localhost";
$port     = "5432";
$dbname   = "pizza_db";      // <-- Make sure there is a semicolon here!
$user     = "postgres";      // <-- And here!
$password = "CAMO"; // <-- And here!

$conn_string = "host={$host} port={$port} dbname={$dbname} user={$user} password={$password}";

$dbconn = pg_connect($conn_string);

if (!$dbconn) {
    die("Connection failed: " . pg_last_error());
}
?>